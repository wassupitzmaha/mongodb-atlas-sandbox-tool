
# -----------------------------------------------------------------------------
# MongoDB Atlas API Authentication
# -----------------------------------------------------------------------------
#
ATLAS_CLIENT_ID=[REQUIRED]
ATLAS_CLIENT_SECRET=[REQUIRED]

# Your MongoDB Atlas Project ID (not Organization ID!)
# Find it: Atlas Console → Project Settings → Project ID
ATLAS_GROUP_ID=[REQUIRED]

# The production cluster to use as snapshot source
# This cluster will ONLY be read from (for snapshots)
# It will NEVER be modified or deleted by this tool
PRODUCTION_CLUSTER_NAME=[REQUIRED]

# -----------------------------------------------------------------------------
#Server Configuration
# -----------------------------------------------------------------------------
# Port the Express server will listen on
PORT=3007

# Environment mode (development, staging, production)
NODE_ENV=DEVELOPMENT

# Frontend URL for CORS configuration
# Development: http://localhost:5173 (Vite default)
# Production: Update to your deployed frontend URL
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# MongoDB Atlas API URLs
# -----------------------------------------------------------------------------
# DO NOT CHANGE THESE - Official MongoDB Atlas API endpoints
ATLAS_AUTH_URL=https://cloud.mongodb.com/api/oauth/token
ATLAS_API_BASE_URL=https://cloud.mongodb.com/api/atlas/v2